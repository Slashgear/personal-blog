---
import { SITE, SOCIALS } from "@config";
import "@styles/base.css";
import { ClientRouter } from "astro:transitions";
import pictureOfMe from "@assets/picture-of-me.png";

const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

export interface Props {
  title?: string;
  author?: string;
  profile?: string;
  description?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: "website" | "article";
  canonicalURL?: string;
  alternates?: { hreflang: string; href: string }[];
  pubDatetime?: Date;
  modDatetime?: Date | null;
  scrollSmooth?: boolean;
  lang?: string;
  noindex?: boolean;
  headline?: string;
  keywords?: string[];
  wordCount?: number;
  articleSection?: string;
}

const {
  title = SITE.title,
  author = SITE.author,
  profile = SITE.profile,
  description = SITE.desc,
  ogImage = SITE.ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogType = "website",
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  alternates = [],
  pubDatetime,
  modDatetime,
  scrollSmooth = false,
  lang,
  noindex = false,
  headline = title,
  keywords = [],
  wordCount,
  articleSection,
} = Astro.props;

// Normalize to a single line: block-scalar frontmatter can carry newlines.
const pageDescription = description.replace(/\s+/g, " ").trim();

const socialImageURL = new URL(
  ogImage ?? SITE.ogImage ?? "og.png",
  Astro.url.origin
).href;

const ogLocale = lang === "fr" ? "fr_FR" : "en_US";

// Social profiles used to disambiguate the author entity (Person + sameAs).
const socialHrefs = SOCIALS.filter(s => s.active).map(s => s.href);
const authorId = new URL("#author", SITE.website).href;
const authorImage = new URL(pictureOfMe.src, Astro.url.origin).href;

// Emit BlogPosting only on actual articles (they pass pubDatetime); every
// other page describes the site itself. A BlogPosting with
// `datePublished: "undefined"` is invalid structured data.
const structuredData = pubDatetime
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline,
      description: pageDescription,
      image: `${socialImageURL}`,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
      datePublished: pubDatetime.toISOString(),
      ...(modDatetime && { dateModified: modDatetime.toISOString() }),
      author: [
        {
          "@type": "Person",
          "@id": authorId,
          name: `${author}`,
          url: `${profile}`,
          image: authorImage,
          sameAs: socialHrefs,
        },
      ],
      publisher: {
        "@type": "Person",
        "@id": authorId,
        name: `${author}`,
        url: `${profile}`,
      },
      inLanguage: lang ?? "en",
      ...(keywords.length && { keywords: keywords.join(", ") }),
      ...(articleSection && { articleSection }),
      ...(wordCount && { wordCount }),
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: SITE.title,
      url: SITE.website,
      description: SITE.desc,
      author: {
        "@type": "Person",
        "@id": authorId,
        name: SITE.author,
        url: SITE.profile,
        image: authorImage,
        sameAs: socialHrefs,
      },
      potentialAction: {
        "@type": "SearchAction",
        target: {
          "@type": "EntryPoint",
          urlTemplate: `${new URL("/search/", SITE.website).href}?q={search_term_string}`,
        },
        "query-input": "required name=search_term_string",
      },
    };
---

<!doctype html>
<html lang={`${lang ?? "en"}`} class={`${scrollSmooth ? "scroll-smooth" : ""}`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {
      alternates.map(alt => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    <meta name="generator" content={Astro.generator} />

    <!-- General Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={author} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:type" content={ogType} />

    <!-- Article Published/Modified time -->
    {
      pubDatetime && (
        <>
          <meta
            property="article:published_time"
            content={pubDatetime.toISOString()}
          />
          <meta property="article:author" content={profile} />
        </>
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }
    {
      articleSection && <meta property="article:section" content={articleSection} />
    }
    {
      keywords.map(keyword => <meta property="article:tag" content={keyword} />)
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Google JSON-LD Structured data -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": authorId,
        name: SITE.author,
        url: SITE.profile,
        image: authorImage,
        sameAs: socialHrefs,
      })}
    />

    <!-- IBM Plex Mono is self-hosted via @fontsource (see src/styles/base.css) -->

    <meta name="theme-color" content="darkgrey" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Antoine Caron Blog"
      href="/rss.xml"
    />
    {
      // If PUBLIC_GOOGLE_SITE_VERIFICATION is set in the environment variable,
      // include google-site-verification tag in the heading
      // Learn more: https://support.google.com/webmasters/answer/9008080#meta_tag_verification&zippy=%2Chtml-tag
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }

    <ClientRouter />

    <script is:inline src="/toggle-theme.js" async></script>
  </head>
  <body>
    <slot />
  </body>
</html>
