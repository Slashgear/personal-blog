---
import { getImage } from "astro:assets";
import type { Conference } from "../types";
import Event from "./Event.astro";

export interface Props {
  conference: Conference;
}

const { conference } = Astro.props;
const { title, year, lang, type, description, events, cospeakers, image } =
  conference.data;

const cover = image ? await getImage({ src: image, width: 1200 }) : undefined;

const typeLabel = type === "workshop" ? "WORKSHOP" : "TALK";
const langLabel = lang === "fr" ? "🇫🇷 FR" : "🇬🇧 EN";
---

<li class="talk">
  {cover && (
    <div class="talk-cover">
      <img
        src={cover.src}
        width={cover.attributes.width}
        height={cover.attributes.height}
        alt={`${title} — photo de la conférence`}
        loading="lazy"
      />
    </div>
  )}

  <div class="talk-body">
    <div class="talk-head">
      <span class="talk-type">{typeLabel}</span>
      <span class="talk-lang">{langLabel}</span>
      <span class="talk-year">{year}</span>
    </div>
    <h2 class="talk-title">{title}</h2>
    <p class="talk-desc">{description}</p>

    {
      cospeakers && cospeakers.length > 0 && (
        <p class="talk-cospeakers">
          <span class="meta-key">Avec</span>
          {cospeakers.map(speaker => (
            <a href={speaker.site} target="_blank" rel="noopener noreferrer">
              {speaker.name}
            </a>
          ))}
        </p>
      )
    }
  </div>

  <div class="talks-events">
    <span class="meta-key">Prises de parole</span>
    <ul class="events-list">
      {events.map(event => <Event event={event} />)}
    </ul>
  </div>
</li>

<style>
  @reference "../styles/base.css";
  .talk {
    @apply flex min-w-0 flex-col gap-5 overflow-hidden rounded-xl border p-6 transition-all duration-200;
    border-color: rgba(var(--color-border), 0.4);
    background: rgba(var(--color-fill), 0.4);
    list-style: none;
  }
  .talk:hover {
    border-color: rgb(var(--color-accent));
    background: rgba(var(--color-accent), 0.04);
    transform: translateY(-2px);
    box-shadow: 0 4px 24px rgba(var(--color-accent), 0.12);
  }

  .talk-cover {
    @apply -mx-6 -mt-6 mb-0 min-w-0 overflow-hidden;
  }
  .talk-cover img {
    @apply aspect-video w-full min-w-0 object-cover;
  }

  .talk-body {
    @apply flex min-w-0 flex-col gap-3;
  }
  .talk-head {
    @apply flex flex-wrap items-center gap-2;
  }
  .talk-type {
    @apply rounded border border-skin-accent px-2.5 py-0.5 text-xs font-bold tracking-widest text-skin-accent;
  }
  .talk-lang {
    @apply text-xs opacity-60;
  }
  .talk-year {
    @apply ml-auto text-lg font-bold text-skin-accent;
  }
  .talk-title {
    @apply m-0 text-2xl font-bold leading-snug;
  }
  .meta-key {
    @apply text-[10px] font-semibold uppercase tracking-widest opacity-70;
  }
  .talk-desc {
    @apply m-0 text-sm opacity-80;
    line-height: 1.6;
  }
  .talk-cospeakers {
    @apply m-0 flex flex-wrap items-baseline gap-1.5 text-sm;
  }
  .talk-cospeakers a {
    @apply text-skin-accent underline decoration-dashed underline-offset-4 hover:opacity-80;
  }

  .talks-events {
    @apply flex flex-col gap-3 border-t border-skin-line/50 pt-4;
  }
  .events-list {
    @apply m-0 flex list-none flex-col gap-2 p-0;
  }
</style>
