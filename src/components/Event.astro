---
import type { Event } from "../types";
export interface Props {
  event: Event;
}

const { event } = Astro.props;

const date = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "short",
  year: "numeric",
}).format(new Date(event.date));

const href = event.link || event.site;
---

<li class="event">
  <time class="event-date" datetime={date}>{date}</time>
  <span class="event-name">{event.name}</span>
  <span class="event-actions">
    {event.video && (
      <a
        href={event.video}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Vidéo de ${event.name}`}
        >Vidéo ↗</a
      >
    )}
    {href && (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Détails de ${event.name}`}
        >Détails ↗</a
      >
    )}
  </span>
</li>

<style>
  @reference "../styles/base.css";
  .event {
    @apply flex flex-wrap items-center gap-x-3 gap-y-1 text-sm;
    list-style: none;
  }
  .event-date {
    @apply shrink-0 text-xs uppercase tracking-wide opacity-60;
  }
  .event-name {
    flex: 1 0 auto;
    min-width: 8rem;
    font-weight: 500;
  }
  .event-actions {
    @apply ml-auto flex shrink-0 items-center gap-2;
  }
  .event-actions a {
    @apply inline-flex items-center gap-1 whitespace-nowrap rounded-md border border-skin-line/50 px-2.5 py-1 text-xs no-underline transition-colors;
    text-decoration: none;
  }
  .event-actions a:hover {
    border-color: rgb(var(--color-accent));
    color: rgb(var(--color-accent));
  }
</style>
